// 1. Test short-circuit and / or
attivo = false;
if (attivo and variabile_inesistente) {
    print "Errore and";
} else {
    print "Short-circuit su AND: OK";
}

ok = true;
if (ok or altra_variabile_inesistente) {
    print "Short-circuit su OR: OK";
}

// 2. Test operatori non short-circuit (& e |) con operandi validi
cond1 = true & true;
cond2 = false | true;
if (cond1 and cond2) {
    print "Operatori non short-circuit (& e |): OK";
}

// 3. Test comando 'leave' (uscita dal blocco locale al blocco esterno)
{
    print "Entrato nel blocco locale";
    leave;
    print "Questa riga dentro il blocco deve essere saltata!";
}
print "Uscita dal blocco con leave riuscita: OK";

// 4. Test comando 'exit' (terminazione immediata del programma)
exit;
print "Questa riga finale non deve essere stampata!";